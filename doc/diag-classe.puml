@startuml

title "Diagramme de classes - R & D"


class Touite {
    - message : string
    - date : string
    + extraireTags(string) : void

    + __get(string) : mixed
}

class Utilisateur {
    - pseudo : string
    - touitesPublies : array
    - touitesSuivis : array
    - tags : array
    - utilisateursSuivis : array
    - touitesAbonnes : array

'    Publication de touites
'    + publier(Touite)
    + ajouterTouite(Touite)
'    + supprimer(Touite)
'    + modifier(Touite, Touite)
'    + relayer(Touite)

'    Evaluation de touite (like / dislike) :
'    + aprouver(Touite)
'    + rejeter(Touite)

'   Social
    + suivreUtilisateur(Utilisateur) : void
'    + suivreTag(Tag)

    + __get(string) : mixed
}

class Profil {
    - nom : string
    - prenom : string
    - email : string
    - nbTouite : int

    + __get(string) : mixed
}

class Tag {
    - idTag : int
    - libelleTag : string
    - descriptionTag : string
    + {static} estLibelleValide(string) : bool

    + __get(string) : mixed
}


abstract class Repository {
    - {static} instance : self
    # {abstract} __construct()
    + getInstance() : self
}

class RepoDev {
    - touites : array
    - utilisateurs: array
    - tags: array
    # __construct()
    + getUtilisateurs() : array
    + getUtilisateur(string) : array
    + getTouites() : array
    + getTouite(int) : array
    + getTags() : array
    + getTag(int) : array

}
class RepoBD {
    {abstract}à coder dans la partie BD
}
Repository <|-- RepoDev : etend
Repository <|-- RepoBD : etend

Utilisateur "1" -> "*" Touite      : - touites
Touite      " " <- "*" Tag         : - tags
Utilisateur "*" <- " " Touite      : - auteur
Profil      "1" <- " " Utilisateur : - profil

' ↓ ↓ ↓ ↓ [R&D] ↓ ↓ ↓ ↓
'abstract class Suivable {}
'Suivable "*" <- Suivable : - suivis
'Suivable <|-- Tag : etend
'Suivable <|-- Utilisateur: etend


@enduml