@startuml

title "Diagramme de classes - R & D"


class Touite {
    - message : string
    - date : string
}

class Utilisateur {
    - pseudo : string
'    Publication de touites
    + publier(Touite)
    + supprimer(Touite)
    + modifier(Touite, Touite)
    + relayer(Touite)
'    Evaluation de touite (like / dislike) :
    + aprouver(Touite)
    + rejeter(Touite)
}

class Profil {
    - nom : string
    - prenom : string
    - email : string
    - nbTouite : int
}

class Tag {
    - nom : string
}


abstract class Repository {
    - {static} instance : self
    # {abstract} __construct()
    + getInstance() : self
    + {abstract} stocker(string, mixed) : int
    + enregistrer(mixed) : int
    + {abstract} recuperer(string, int)
}

class RepoDev {
    - {static} TOUITES : string
    - {static} UTILISATEURS : string
    - touites : array
    - utilisateurs: array
    - increment : int
    # __construct()
    # stocker(string, mixed) : int
    + recuperer(string
}
class RepoBD {
    {abstract}à coder dans la partie BD
}
Repository <|-- RepoDev : etend
Repository <|-- RepoBD : etend

Utilisateur "1" -> "*" Touite      : - touites
Touite      " " <- "*" Tag         : - tags
Utilisateur "*" <- " " Touite      : - auteur
Profil      "1" <- " " Utilisateur : - profil

